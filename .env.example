# Backend / Hostinger
PORT=3000
DATABASE_URL=postgres://controle:SENHA_FORTE_DO_POSTGRES@localhost:5432/controle_atestados
APP_PUBLIC_ORIGIN=http://localhost:3000
RUN_MIGRATIONS=true

# Frontend
# Em producao Docker, deixe vazio para usar a mesma origem do site.
VITE_API_BASE_URL=http://localhost:3000

# Nexti
NEXTI_CLIENT_ID=
NEXTI_CLIENT_SECRET=
NEXTI_API_BASE_URL=https://api.nexti.com
NEXTI_TOKEN_URL=https://api.nexti.com/security/oauth/token

# Sincronizacao
NEXTI_AUTO_SYNC_ENABLED=true
NEXTI_SYNC_POLL_SECONDS=60
NEXTI_SYNC_INITIAL_LOOKBACK_DAYS=365
NEXTI_SYNC_OVERLAP_MINUTES=15
NEXTI_SYNC_MIN_INTERVAL_SECONDS=60

# Filtros opcionais de atestado medico
NEXTI_MEDICAL_ABSENCE_SITUATION_IDS=
NEXTI_MEDICAL_ABSENCE_SITUATION_EXTERNAL_IDS=
NEXTI_USER_ACCOUNT_LOOKBACK_START=01012000
NEXTI_OPERATOR_NAME_OVERRIDES=

# Notificacoes n8n
NOTIFICATION_SITE_URL=https://nextibombeiros-bit.github.io/CONTROLE-DE-ATESTADOS/
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
NOTIFICATION_MAX_ATTEMPTS=5
